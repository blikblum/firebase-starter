{
  "name": "tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:emulators": "firebase emulators:start --config ../../firebase.json --project demo-no-project --only auth,firestore",
    "dev:seed": "wait-on --timeout 30s --log tcp:127.0.0.1:9099 tcp:127.0.0.1:8080 && pnpm run populate:data",
    "populate:data": "node --loader ts-node/esm src/populateData.ts"
  },
  "dependencies": {
    "base": "workspace:*",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "wait-on": "9.1.0"
  }
}
