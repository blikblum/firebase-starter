{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev:app": {
      "cache": false,
      "persistent": true,
      "with": ["tools#dev:emulators", "tools#dev:seed"]
    },
    "dev:emulators": {
      "cache": false,
      "persistent": true
    },
    "dev:seed": {
      "cache": false
    },
    "populate:data": {
      "cache": false
    }
  }
}
